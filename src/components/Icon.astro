---
// Inlines a Lucide icon at build time: no icon font, no runtime JS.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props { name: string; label?: string; }
const { name, label } = Astro.props;
const require = createRequire(import.meta.url);
const svg = readFileSync(require.resolve(`lucide-static/icons/${name}.svg`), 'utf8')
  .replace(/<!--[\s\S]*?-->/g, '')
  .trim();
---
<span class="icon" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={svg} />
