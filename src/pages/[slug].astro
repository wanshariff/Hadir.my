---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { events, formatDate, formatTime, mapsLinks, googleCalendarUrl, type HadirEvent } from '../lib/events';
import { eventCopy, ui } from '../lib/copy';

export function getStaticPaths() {
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props as { event: HadirEvent };
const t = ui[event.lang];
const c = eventCopy[event.type][event.lang];
const date = formatDate(event.startsAt, event.lang);
const time = `${formatTime(event.startsAt, event.lang)} – ${formatTime(event.endsAt, event.lang)}`;
const maps = mapsLinks(event);
const calTitle = `${c.title}: ${event.hostNames}`;
const gcal = googleCalendarUrl(event, calTitle);
const rsvpBy = event.rsvpBy ? formatDate(`${event.rsvpBy}T12:00:00+08:00`, event.lang) : null;
const ctaHref = `/?utm_source=invite&ref=${event.slug}`;

// The link preview alone must show names, date and venue (PRD: scam-safe sharing).
const title = `${c.title} · ${event.hostNames}`;
const description = `${date}, ${time} · ${event.venue.name}. ${t.safe}.`;
---
<Base title={title} description={description} lang={event.lang === 'bm' ? 'ms' : 'en'} tone={event.type === 'tahlil' ? 'muted' : undefined} noindex>
  <main class="invite" id="top"
    data-slug={event.slug}
    data-starts={event.startsAt}
    data-max-pax={event.maxPax}
    data-ics={`/${event.slug}.ics`}
    data-t={JSON.stringify({ saving: t.saving, saved: t.saved, retry: t.retry, failed: t.failed, nameRequired: t.nameRequired, people: t.people, yes: t.yes, no: t.no, thanksYes: t.thanksYes, thanksNo: t.thanksNo, music: t.music, pause: t.pause, edit: t.edit, inDays: `${t.countdown} {n} ${t.days}` })}
  >
    <header class="cover aurora">
      {event.musicUrl && (
        <button class="btn btn-icon music" type="button" aria-pressed="false" aria-label={t.music} data-src={event.musicUrl}>
          <Icon name="music" />
        </button>
      )}
      <p class="badge">{c.title}</p>
      {event.hostedBy && <p class="hosted-by">{event.hostedBy}</p>}
      <p class="intro">{c.intro}</p>
      <h1 class="names">{event.hostNames}</h1>
      <p class="cover-date">{date}</p>
      <p class="countdown tnum" hidden><span data-countdown></span></p>
    </header>

    <div class="stack">
      <section class="panel details" aria-labelledby="details-h">
        <h2 id="details-h" class="sr-only">{t.when}</h2>
        <div class="row">
          <Icon name="calendar" />
          <div>
            <p class="eyebrow-label">{t.when}</p>
            <p>{date}<br /><span class="tnum">{time}</span></p>
          </div>
        </div>
        <div class="row" id="tempat">
          <Icon name="map-pin" />
          <div>
            <p class="eyebrow-label">{t.where}</p>
            <p><strong>{event.venue.name}</strong><br />{event.venue.address}</p>
          </div>
        </div>
        <div class="actions">
          <a class="btn" href={maps.waze} rel="noopener" target="_blank"><Icon name="navigation" />Waze</a>
          <a class="btn" href={maps.google} rel="noopener" target="_blank"><Icon name="map" />Google Maps</a>
          <a class="btn btn-wide" href={gcal} rel="noopener" target="_blank" data-calendar><Icon name="calendar-plus" />{t.calendar}</a>
        </div>
        {event.note && <p class="note">{event.note}</p>}
      </section>

      <section class="panel rsvp" id="rsvp" aria-labelledby="rsvp-h">
        <h2 id="rsvp-h">{t.rsvpTitle}</h2>
        {rsvpBy && <p class="hint">{t.rsvpBy(rsvpBy)}</p>}

        <div class="mine" hidden>
          <p class="eyebrow-label">{t.yourAnswers}</p>
          <ul class="mine-list"></ul>
          <button class="btn btn-block" type="button" data-new>
            <Icon name="user-plus" />{t.answerForOther}
          </button>
        </div>

        <form novalidate>
          <div class="choice" role="group" aria-label={t.rsvpTitle}>
            <button class="btn" type="button" data-status="hadir" aria-pressed="false"><Icon name="check" />{t.yes}</button>
            <button class="btn" type="button" data-status="tak_hadir" aria-pressed="false"><Icon name="x" />{t.no}</button>
          </div>

          <div class="fields" hidden>
            <div class="field">
              <label for="f-name">{t.name}</label>
              <input id="f-name" name="name" autocomplete="name" maxlength="80" required aria-describedby="f-name-err" />
              <p class="field-error" id="f-name-err" hidden></p>
            </div>
            <div class="field" data-pax-field>
              <span class="field-label" id="f-pax-l">{t.pax}</span>
              <div class="stepper" role="group" aria-labelledby="f-pax-l">
                <button type="button" class="btn btn-icon" data-step="-1" aria-label="-1"><Icon name="minus" /></button>
                <output id="f-pax" aria-live="polite">1</output>
                <button type="button" class="btn btn-icon" data-step="1" aria-label="+1"><Icon name="plus" /></button>
              </div>
            </div>
            <div class="field">
              <label for="f-phone">{t.phone}</label>
              <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" aria-describedby="f-phone-why" />
              <p class="hint" id="f-phone-why">{t.phoneWhy}</p>
            </div>
            <div class="accordion">
              <details>
                <summary>{t.doa}</summary>
                <div>
                  <label for="f-msg" class="sr-only">{t.doa}</label>
                  <textarea id="f-msg" name="message" maxlength="500"></textarea>
                </div>
              </details>
            </div>
            <button class="btn btn-primary btn-block" type="submit">{t.send}</button>
            <p class="status" role="status" aria-live="polite"></p>
          </div>
        </form>

        <div class="thanks" hidden>
          <p class="alert alert-success thanks-msg"></p>
          <p class="hint">{t.ownEvent}</p>
          <a class="btn btn-block" href={`${ctaHref}&utm_medium=thanks`} data-track="cta_from_invite">{t.ownEventCta}</a>
        </div>
      </section>
    </div>

    <footer class="foot">
      <p class="safe"><Icon name="shield-check" />{t.safe} · <a href="/selamat">{t.safeMore}</a></p>
      <p class="made"><a href={`${ctaHref}&utm_medium=footer`} data-track="cta_from_invite">{t.madeWith} · {t.makeYours}</a></p>
    </footer>

    <nav class="app-bar" aria-label="Pintasan">
      <a href="#rsvp"><Icon name="circle-check" /><span>Hadir</span></a>
      <a href="#tempat"><Icon name="map-pin" /><span>Peta</span></a>
      <a href={gcal} rel="noopener" target="_blank" data-calendar><Icon name="calendar-plus" /><span>Kalendar</span></a>
    </nav>
  </main>

  <script src="../scripts/invite.ts"></script>
</Base>

<style>
  .invite {
    max-width: 560px; margin: 0 auto;
    padding: 0 var(--space-4) calc(var(--bar-h) + var(--space-8));
    font-size: var(--text-guest); /* PRD: 18px for elder readers */
  }
  .cover {
    position: relative; text-align: center;
    display: grid; justify-items: center; gap: var(--space-2);
    padding: var(--space-12) var(--space-2) var(--space-10);
    margin: 0 calc(-1 * var(--space-4));
  }
  .cover .badge { margin-bottom: var(--space-4); }
  .hosted-by, .intro { color: var(--text-muted); max-width: 32ch; }
  .names { font-size: var(--text-h1); margin: var(--space-3) 0 var(--space-2); }
  .cover-date { font-weight: var(--weight-body-strong); }
  .countdown { color: var(--text-muted); font-size: var(--text-body); }
  .music { position: absolute; top: var(--space-3); right: var(--space-4); background: var(--surface); border-color: var(--border); }

  .stack { display: grid; gap: var(--space-4); }
  .row { display: flex; gap: var(--space-4); align-items: flex-start; }
  .row + .row { margin-top: var(--space-5); }
  .row > .icon { margin-top: 2px; color: var(--text-muted); }
  .row .eyebrow-label { margin-bottom: var(--space-1); }
  .actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin-top: var(--space-6); }
  .btn-wide { grid-column: 1 / -1; }
  .note { margin-top: var(--space-5); padding-top: var(--space-5); border-top: 1px solid var(--border); color: var(--text-muted); }

  .rsvp h2 { font-size: var(--text-h3); }
  .rsvp > .hint { margin-top: var(--space-1); }
  .choice { display: grid; gap: var(--space-2); margin: var(--space-5) 0; }
  .choice .btn { min-height: 56px; font-size: var(--text-guest); }
  .fields { display: grid; gap: var(--space-5); }
  .status { min-height: 1.5em; text-align: center; color: var(--text-muted); }
  .mine { display: grid; gap: var(--space-2); margin: var(--space-5) 0 var(--space-2); }
  .mine-list { list-style: none; padding: 0; margin: 0; }
  .thanks { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  .thanks-msg { font-weight: var(--weight-body-strong); font-size: var(--text-h5); }

  .foot { display: grid; gap: var(--space-2); text-align: center; margin-top: var(--space-8); font-size: var(--text-body); color: var(--text-muted); }
  .safe { display: flex; gap: var(--space-2); justify-content: center; align-items: center; flex-wrap: wrap; }
  .safe .icon { color: var(--success-fg); }
  .safe a, .made a { color: var(--text-muted); }
  .made a { display: inline-block; padding: var(--space-3); }

  :global(html) { scroll-padding-bottom: calc(var(--bar-h) + var(--space-4)); scroll-behavior: smooth; }
</style>

<style is:global>
  /* Rendered by invite.ts, so not scoped. */
  .mine-list li {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-3);
    padding: var(--space-3) 0; border-bottom: 1px solid var(--border);
  }
</style>
